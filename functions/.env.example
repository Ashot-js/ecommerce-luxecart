# LuxeCart API — Environment Variables (Render)
# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the Web Service settings.

# PostgreSQL connection string (Supabase: Connect -> Session pooler)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWT tokens — generate a random 64-char string
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-secret-change-me

# Port the server listens on (Render sets PORT automatically)
PORT=5000

# Optional: comma-separated allowed frontend origins (default: the Firebase site + localhost:5173)
# CLIENT_URL=https://ecommerce-luxecart.web.app
